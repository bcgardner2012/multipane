[node name="Notes" type="TextEdit" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.005
anchor_top = 0.15
anchor_right = 0.18
anchor_bottom = 0.9
offset_right = 8.0
grow_vertical = 2
text = "Instructions:
- Click the deck to start.
- The goal is to play higher cards
than your opponent to move the
ball into their goal.
- Aces are special. They beat all face
cards, but lose to all number cards.
- Both players get all 13 cards of 1
suit each half.
- The game is played in 2 halves. A
half is over when you've played all
13 of your cards.
- Most goals scored at the end wins."
placeholder_text = "Add any notes here..."
script = ExtResource("4_ewpap")

