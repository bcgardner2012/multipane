[node name="Notes" type="TextEdit" parent="."]
visible = false
layout_mode = 1
anchors_preset = -1
anchor_left = 0.005
anchor_top = 0.15
anchor_right = 0.18
anchor_bottom = 0.9
offset_right = 8.0
grow_vertical = 2
text = "Instructions:
- Click the deck to start.
- The goal is to collect all the aces.
- You have 25 health.
- 2s are empty rooms. By default,
they do nothing, just a break from
the horrors of the house.*
- 3-10 are minor horrors, dealing 1
damage unless a check is passed.
By default, the check is rolling 2
dice and seeing they >= the rank.
- Jacks are ghosts dealing 2 damage.
- Queens are benevolent spirits that
heal you 2 HP.
- Kings are angry ghosts dealing 3
damage.
- The Joker is an eldritch horror or
serial killer, attacks you for 5 dmg.
- Game over if you lose all health.
- * Multiple versions of this game
exist, see settings for configurable
details.
- Dice rolls will be performed in the
background, results communicated
through text."
placeholder_text = "Add any notes here..."
script = ExtResource("4_jqr1f")

