[node name="OptionButton" type="OptionButton" parent="Settings/GameModeSelector"]
layout_mode = 2
item_count = 3
popup/item_0/text = "Default"
popup/item_0/id = 0
popup/item_1/text = "Deluxe"
popup/item_1/id = 1
popup/item_2/text = "Anger&Curses"
popup/item_2/id = 2

[node name="GameModeDescription" type="Label" parent="Settings"]
layout_mode = 0
offset_top = 56.4
offset_right = 40.0
offset_bottom = 79.4
text = "Default: As described in the instructions

Deluxe: adds items found in safe rooms (2s),
10s are random events, Jacks are traps, all
3-9s have a 50% chance of dealing 1 damage

Anger&Curses: deluxe, plus 2 more gauges:
Curse and Anger. Items you find can be 
cursed causing a different effect and giving
1 curse. Anger increases by the rank of each
card drawn. If either gauge maxes out, game
over. Queens and safe rooms provide a way
to lower them. 3s and 6s are cursing parrots,
they have a 50% chance of adding 1 curse."
label_settings = SubResource("LabelSettings_i5dxx")

