[node name="Notes" type="TextEdit" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.005
anchor_top = 0.15
anchor_right = 0.18
anchor_bottom = 0.9
offset_right = 8.0
grow_vertical = 2
text = "Instructions:
- Goal: win the most votes by winning
the most sub-areas in each region.
- The deck is split by suits. The club
deck is drawn from at the beginning
of each round. The club card drawn
represents the region being
contested this round.
- Players each receive one deck of
one suit.
- Once the club card is revealed, each
player reveals a card. The highest
card wins that area. Once all areas
in a region are voted on, points are
assigned to the majority player.
- In cases where there is no majority,
the area or region remains neutral,
no points
- Contested area will be shown in
yellow."
placeholder_text = "Add any notes here..."
script = ExtResource("4_ygicd")

